{
  "name": "invidious-companion",
  "version": "1.0.0",
  "description": "Companion for Invidious which handles all the video stream retrieval from YouTube servers",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "tsx --test src/tests/ipv6Rotation_test.ts src/tests/validateVideoId_test.ts src/tests/secret_key_validation_test.ts",
    "test:integration": "tsx --test src/tests/main_test.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bgutils-js": "^3.2.0",
    "googlevideo": "^2.0.0",
    "hono": "^4.7.4",
    "jsdom": "^26.1.0",
    "meriyah": "^6.1.4",
    "minimist": "^1.2.8",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.3",
    "smol-toml": "^1.3.1",
    "undici": "^6.21.1",
    "youtubei.js": "^17.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.11.24",
    "@types/node-cron": "^3.0.11",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
